# Django core
SECRET_KEY=replace-me-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DB_NAME=ebarangay
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Cookie security
# Local dev: COOKIE_SECURE=False, COOKIE_SAMESITE=Lax
# Cross-site production: COOKIE_SECURE=True, COOKIE_SAMESITE=None
COOKIE_SECURE=False
COOKIE_SAMESITE=Lax
